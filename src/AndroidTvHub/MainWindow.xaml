<?xml version="1.0" encoding="UTF-8"?>
<Window
    x:Class="AndroidTvHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Android TV Hub">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Android TV Hub" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Windows App Player for an AOSP/Lineage Android TV Guest. No Play Store, no Google TV."
                       TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="Runtime" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="QemuStatusText" TextWrapping="Wrap"/>
                <TextBlock x:Name="WhpxStatusText" TextWrapping="Wrap"/>
                <TextBlock x:Name="ImageStatusText" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <NumberBox x:Name="CpuBox" Header="CPU cores" Minimum="2" Maximum="16" SpinButtonPlacementMode="Inline" ValueChanged="SettingsChanged"/>
                <NumberBox x:Name="RamBox" Header="RAM (MB)" Minimum="2048" Maximum="16384" SmallChange="512" LargeChange="1024" SpinButtonPlacementMode="Inline" ValueChanged="SettingsChanged"/>
                <ComboBox x:Name="DisplayCombo" Header="Display" SelectionChanged="SettingsChanged">
                    <ComboBoxItem Content="Windowed" Tag="Windowed"/>
                    <ComboBoxItem Content="Exclusive fullscreen" Tag="ExclusiveFullscreen"/>
                </ComboBox>
                <ComboBox x:Name="UiSizeCombo" Header="Guest UI" SelectionChanged="SettingsChanged">
                    <ComboBoxItem Content="1920 × 1080" Tag="1080"/>
                    <ComboBoxItem Content="3840 × 2160" Tag="2160"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
            <Button x:Name="DownloadButton" Content="Download Guest ISO" Click="DownloadClick"/>
            <Button x:Name="StartButton" Content="Start Guest" Click="StartClick" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="StopButton" Content="Stop Guest" Click="StopClick"/>
            <Button x:Name="SideloadButton" Content="Sideload APK" Click="SideloadClick"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="DownloadProgress" Height="8" Visibility="Collapsed"/>
            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock x:Name="LogText" Margin="12" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
